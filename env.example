# Template for ~/.env — per-machine values and secrets for the agent skills in
# agents/skills/. Copy to ~/.env, fill in, `chmod 600 ~/.env`. Never commit it.
# Skills source it themselves (`set -a; . ~/.env; set +a`); it is NOT exported
# from .zshrc, so secrets don't leak into every process's environment.

# Paperclip (paperclip-* skills)
PAPERCLIP_PUBLIC_URL=          # e.g. https://paperclip.example.com (Cloudflare Access hostname, no trailing slash)
PAPERCLIP_KUBE_CONTEXT=        # kubectl context of the cluster running Paperclip
PAPERCLIP_NAMESPACE=           # namespace of deploy/paperclip
PAPERCLIP_COMPANY_ID=
PAPERCLIP_BOARD_TOKEN=         # refresh with the paperclip-board-token skill (--store)

# Path of the home-lab checkout (paperclip-debug-run fixes land there)
HOMELAB=
